# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ahava
# Pooled (PgBouncer) connection string - Railway auto-provisions this alongside
# DATABASE_URL. Prisma uses this for all runtime queries to avoid exhausting
# Postgres's max_connections under high concurrency. Falls back to
# DATABASE_URL if unset (e.g. local development without PgBouncer).
POOLED_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ahava

# JWT (JWT_SECRET must be >= 32 chars in production)
JWT_SECRET=change-me-generate-a-long-random-secret-at-least-32-chars
# Access tokens are bearer credentials that are not checked against a
# revocation list on every request, so keep them short and let the refresh
# flow do the work. This said 24h, which contradicted the code default of 15m.
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (required by scripts/validate-env.js)
ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase-key
ENCRYPTION_IV_SALT=change-me-random-salt
# AH-13 key rotation (all optional). ENCRYPTION_KEY_ID names the current
# ENCRYPTION_KEY's generation and is embedded in every new encrypted value.
# To rotate: move today's ENCRYPTION_KEY/ENCRYPTION_KEY_ID into the
# _PREVIOUS pair below, then set a newly generated ENCRYPTION_KEY/
# ENCRYPTION_KEY_ID. Both keys stay live for reads until every row tagged
# with the previous id has been re-encrypted, then drop the _PREVIOUS pair.
# ENCRYPTION_KEY_ID=2026-09
# ENCRYPTION_KEY_PREVIOUS=
# ENCRYPTION_KEY_PREVIOUS_ID=

# PayFast Payment Gateway (South Africa)
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase
PAYFAST_SANDBOX=true

# Application
# NOTE: must NOT be 3000 - the Next.js frontend dev server uses 3000
APP_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Redis (optional - queue/cache degrade gracefully without it)
REDIS_URL=redis://localhost:6379

# Nurse dispatch (optional): how long a nurse's socket may stay disconnected
# before they're marked unavailable, in ms. Default 120000 (2 minutes).
# NURSE_OFFLINE_GRACE_MS=120000

# Key for pseudonymous patient references in admin analytics reports
# (e.g. the BP-validation report). Falls back to ENCRYPTION_KEY if unset.
# PSEUDONYM_KEY=

# Where the data-encryption key comes from (docs/SECURITY_RUNBOOK.md §1).
# "env" (default): ENCRYPTION_KEY above, in plaintext — fine for local dev.
# "aws-kms" (production): ENCRYPTION_KEY must be REMOVED; the key is stored
# only wrapped by an AWS KMS master key and unwrapped in memory at startup.
# ENCRYPTION_KEY_PROVIDER=aws-kms
# ENCRYPTION_KEY_CIPHERTEXT=          # from: pnpm --filter backend wrap-encryption-key
# ENCRYPTION_KEY_PREVIOUS_CIPHERTEXT= # only during a data-key rotation
# ENCRYPTION_KMS_KEY_ID=arn:aws:kms:af-south-1:<account-id>:key/<uuid>
# AWS_REGION=af-south-1
# AWS_ACCESS_KEY_ID=                  # decrypt-only IAM user (runbook §1 step 3)
# AWS_SECRET_ACCESS_KEY=

# AH-33: object storage for triage attachments (optional). Without these,
# attachments are embedded as base64 in the TriageCase row instead - the
# app works either way, this just controls where the bytes live. Works
# against AWS S3 or any S3-compatible provider (Cloudflare R2, Backblaze B2,
# DigitalOcean Spaces) - set S3_ENDPOINT for anything other than AWS.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true

# AI triage providers (optional - conservative fallback is used when absent).
# Model versions are hardcoded in services/aiTriage.ts, not read from env —
# there is no ANTHROPIC_MODEL/GEMINI_MODEL override.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Evidence providers (optional)
NCBI_API_KEY=
STATPEARLS_SERVICE_URL=

# Wearable integrations (optional)
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_WEBHOOK_SECRET=
ROOK_BASE_URL=
ROOK_WEBHOOK_SECRET=

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=Ahava Healthcare <no-reply@ahavahealth.co.za>

# Staff (nurse, doctor, admin) accounts are created by single-use invite
# from the admin dashboard; there is no shared registration secret any more.
# Invite links point at FRONTEND_URL, so set it to the real web app URL.

# Public URL of THIS API. Used for the PayFast notify_url, which must reach the
# API directly - routing the ITN through the frontend proxy strips the raw body
# the signature is computed over. Falls back to APP_URL when unset.
API_PUBLIC_URL=http://localhost:4000

# Set to "true" to allow the demo biometric stream in production. Off by
# default: it injects synthetic vitals into the caller's own clinical record.
ENABLE_DEMO_STREAM=

# Set to "true" to suppress request logging. Logging is on by default.
DISABLE_REQUEST_LOG=

# Upper bound on the graceful-shutdown drain, in milliseconds.
SHUTDOWN_TIMEOUT_MS=15000

# Destructive "reset trial data" admin endpoint (POST /admin/reset-trial-data).
# Disabled whenever NODE_ENV=production unless this is explicitly "true".
# Leave unset in real production; set it only on a trial/demo environment.
# ALLOW_TRIAL_DATA_RESET=true

# Staff session policy (nurses, doctors, admins). Patients are unaffected.
# STAFF_ACCESS_TOKEN_MINUTES=5
# STAFF_SESSION_IDLE_MINUTES=15
# STAFF_SESSION_MAX_HOURS=12
# Fresh-2FA window for sensitive actions (invites, grants, refunds, credential checks...)
# STEP_UP_WINDOW_MINUTES=5
# Failed-login throttling: per account+IP, and per account across all IPs
# LOGIN_MAX_ATTEMPTS_PER_IP=5
# LOGIN_MAX_ATTEMPTS_PER_ACCOUNT=25
# AUTH_LOCKOUT_TTL_SECONDS=900
