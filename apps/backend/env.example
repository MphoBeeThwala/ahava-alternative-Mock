# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ahava
# Pooled (PgBouncer) connection string - Railway auto-provisions this alongside
# DATABASE_URL. Prisma uses this for all runtime queries to avoid exhausting
# Postgres's max_connections under high concurrency. Falls back to
# DATABASE_URL if unset (e.g. local development without PgBouncer).
POOLED_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ahava

# JWT (JWT_SECRET must be >= 32 chars in production)
JWT_SECRET=change-me-generate-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=7d

# Encryption (required by scripts/validate-env.js)
ENCRYPTION_KEY=change-me-32-byte-hex-or-passphrase-key
ENCRYPTION_IV_SALT=change-me-random-salt

# PayFast Payment Gateway (South Africa)
PAYFAST_MERCHANT_ID=your_payfast_merchant_id
PAYFAST_MERCHANT_KEY=your_payfast_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase
PAYFAST_SANDBOX=true

# Application
# NOTE: must NOT be 3000 - the Next.js frontend dev server uses 3000
APP_URL=http://localhost:3000
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Redis (optional - queue/cache degrade gracefully without it)
REDIS_URL=redis://localhost:6379

# AI triage providers (optional - conservative fallback is used when absent)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Evidence providers (optional)
NCBI_API_KEY=
STATPEARLS_SERVICE_URL=

# Wearable integrations (optional)
TERRA_DEV_ID=
TERRA_API_KEY=
TERRA_WEBHOOK_SECRET=
ROOK_BASE_URL=
ROOK_WEBHOOK_SECRET=

# Email (optional)
RESEND_API_KEY=
EMAIL_FROM=Ahava Healthcare <no-reply@ahavahealth.co.za>

# Staff registration secrets (required for staff signup endpoints)
ADMIN_REGISTRATION_SECRET=
STAFF_REGISTRATION_SECRET=
