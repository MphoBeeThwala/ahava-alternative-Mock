      { "kind": "match", "id": "inv_urine_histoplasma", "description": "Urine Histoplasma antigen", "anyOf": ["histoplasma\\s+(?:urine\\s+)?antigen", "urine histoplasma"], "in": "investigations" },
      { "kind": "match", "id": "inv_lp", "description": "Lumbar puncture / CSF for the confusion", "anyOf": ["lumbar puncture", "\\bLP\\b", "\\bCSF\\b"], "in": "investigations" },
