{
  "id": "HIV-HLH-001",
  "title": "Advanced HIV (CD4 9), disseminated fungal infection with secondary HLH, failing empirical TB treatment",
  "status": "gold_draft_pending_clinician_review",
  "source": "Internal test case that exposed weak workup and management (2026-10). Rubric written from the failures listed by the product owner; every item needs clinician sign-off before this case is treated as gold.",
  "input": {
    "caseText": "38 year old woman with advanced HIV, CD4 9, on empirical TB treatment (RHZE) for 6 weeks with no improvement. Fever, new confusion, skin papules, pancytopenia, raised creatinine, ferritin 18000. GeneXpert negative, TB-LAM negative. BP 95/59, sodium 124. Transferred for opinion. Should we continue TB treatment? When should ART be started?",
    "findings": {
      "ageYears": 38, "sex": "F", "sbp": 95, "dbp": 59, "hr": 118, "rr": 24, "tempC": 38.9, "cd4Cells": 9, "hivPositive": true,
      "alteredMentation": true, "haemoglobinGdl": 6.8, "plateletsX10e9": 42, "neutrophilsX10e9": 0.9, "wbcX10e9": 2.1,
      "ferritinUgL": 18000, "triglyceridesMmol": 4.6, "splenomegaly": true, "sodiumMmol": 124, "glucoseMmol": 5.2, "creatinineUmol": 190
    }
  },
  "rubric": {
    "diagnosis": [
      { "kind": "match", "id": "dx_fungal", "weight": 2, "description": "A disseminated fungal infection (histoplasmosis, cryptococcosis, talaromycosis) is the leading diagnosis or in the top 3", "anyOf": ["histoplasm", "disseminated (?:fungal|mycosis)", "talaromyc", "cryptococc"], "in": "top3" },
      { "kind": "match", "id": "dx_hlh", "weight": 1, "description": "Secondary HLH is named", "anyOf": ["\\bHLH\\b", "ha?emophagocytic"], "in": "any" },
      { "kind": "match", "id": "dx_tb_kept", "weight": 1, "description": "Disseminated TB stays on the differential", "anyOf": ["tubercul", "\\bTB\\b"], "in": ["differential", "leadingDiagnosis"] },
      { "kind": "differentialHasEvidence", "id": "dx_evidence", "weight": 1, "description": "At least two differentials give evidence for and against", "min": 2 }
    ],
    "investigations": [
