      { "kind": "match", "id": "inv_crag", "description": "Cryptococcal antigen", "anyOf": ["\\bcrag\\b", "cryptococcal antigen"], "in": "investigations" },
      { "kind": "match", "id": "inv_lactate", "description": "Lactate, so septic-shock criteria can be judged", "anyOf": ["lactate"], "in": "investigations" },
