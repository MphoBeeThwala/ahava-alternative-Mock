{
  "name": "ahava-healthcare",
  "version": "1.0.0",
  "description": "Ahava Healthcare - Full-stack healthcare platform for South Africa - patient bookings, nurse home visits, doctor oversight",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "workspace"
  ],
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "//": "This is a workspace root. It builds and orchestrates apps/backend and workspace; it is not an application itself.",
    "build": "pnpm -r run build",
    "build:frontend": "pnpm --filter workspace build",
    "start:frontend": "pnpm --filter workspace start",
    "dev": "pnpm -r --parallel run dev",
    "dev:api": "pnpm --filter @ahava-healthcare/api dev",
    "test": "pnpm -r run test",
    "test:backend": "pnpm --filter @ahava-healthcare/api test",
    "test:integration": "pnpm --filter @ahava-healthcare/api test:integration",
    "test:e2e": "node e2e/run.mjs",
    "lint": "pnpm -r run lint",
    "lint:fix": "pnpm -r run lint:fix",
    "type-check": "pnpm -r run type-check",
    "clean": "pnpm -r run clean",
    "prisma:generate": "pnpm --filter @ahava-healthcare/api prisma:generate",
    "prisma:migrate": "pnpm --filter @ahava-healthcare/api prisma:migrate",
    "prisma:seed": "pnpm --filter @ahava-healthcare/api prisma:seed",
    "seed:mock-patients": "pnpm --filter @ahava-healthcare/api seed:mock-patients",
    "seed:from-synthea": "pnpm --filter @ahava-healthcare/api seed:from-synthea",
    "synthea:run-and-seed": "node scripts/run-synthea-and-seed.js",
    "load-test:patient-pipeline": "node scripts/load-test-patient-pipeline.js",
    "test:early-warning": "node scripts/run-early-warning-test.js",
    "test:services": "node scripts/test-services.js",
    "db:reset": "pnpm --filter @ahava-healthcare/api db:reset"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^20.10.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "undici@7": "^7.30.0",
      "uuid@11": "^11.1.1",
      "defu@6": "^6.1.7",
      "deepmerge-ts@7": "^8.0.2",
      "form-data@4": "^4.0.6",
      "follow-redirects@1": "^1.16.0",
      "nanoid@3": "^3.3.19",
      "postcss@8": "^8.5.28",
      "browserslist@4": "^4.29.1",
      "@babel/core@7": "^7.29.7",
      "baseline-browser-mapping@2": "^2.11.26",
      "yaml@1": "^1.10.3",
      "sharp@0.34": "^0.35.4",
      "qs@6": "^6.16.0",
      "body-parser@1": "^1.20.8",
      "path-to-regexp@0.1": "^0.1.13",
      "picomatch@4": "^4.0.4",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@2": "^2.1.7",
      "minimatch@3": "^3.1.5",
      "minimatch@9": "^9.0.9",
      "js-yaml@3": "^3.15.2",
      "js-yaml@4": "^4.3.2",
      "flatted@3": "^3.4.4",
      "ajv@6": "^6.15.0",
      "picomatch@2": "^2.3.2",
      "@humanfs/node@0.16": "^0.16.8",
      "uuid@9": "^11.1.1",
      "uuid@7": "^11.1.1"
    }
  }
}
